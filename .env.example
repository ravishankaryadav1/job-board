# Optional. Copy to .env locally; never commit real credentials.
OPENAI_API_KEY=
# Pick a model available to your API project that supports Structured Outputs.
# gpt-4o-mini is an example, not a requirement. Model choice affects cost/quality.
OPENAI_MODEL=gpt-4o-mini

# Optional: --ai --provider claude, via AWS Bedrock (e.g. through an internal
# gateway like Versa). Requires `pip install -e ".[claude]"`. Standard boto3 env
# var names, so they line up with anything else in your environment reading them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-5
